def _banner(title: str) -> None:
    print("\n" + "=" * 78 + f"\n{title}\n" + "=" * 78)


def run_demonstration() -> None:
    _banner("SATOSHI COMPLEX :: SOVEREIGN EDGE HUB  (local-first, outage-resilient)")
    policy = ConstitutionalPolicy(owner_pubkey_hex=secrets.token_hex(32),
                                  vault_path=Path("/tmp/sovereign_vault.bin"))
    hub = SatoshiComplexHub(policy)

    rng = np.random.default_rng(42)
    t = np.linspace(0, 1.0, 250)
    nominal = 0.5 * np.sin(2 * np.pi * 1.2 * t) + rng.normal(0, 0.12, t.shape)
    probe = 0.04 * np.sin(2 * np.pi * 60.0 * t); probe[115:125] += 4.2        # fault-injection glitch
    emergency = rng.normal(0, 0.35, t.shape); emergency[75:92] += rng.normal(7.5, 1.2, 17)

    # prepay the mesh peers (attacker peer deliberately underfunded)
    hub.billing.topup("mesh_node_A", 500)
    hub.billing.topup("untrusted_ext_09", 200)             # < probe toll (1000) on purpose

    _banner("1) TRIAGE  (probe now detected correctly; emergency billed free)")
    results = hub.triage_batch([("bedroom_radar_01", nominal, "mesh_node_A"),
                                ("gateway_bus_02", probe, "untrusted_ext_09"),
                                ("hallway_fall_03", emergency, "mesh_node_B")])
    for r in results:
        print(f"[{r.get('sensor_id')}] {r.get('threat'):<26} "
              f"{r.get('latency_ms','?')} ms | {r.get('billing',{}).get('detail','')}")

    _banner("2) OUTAGE DEFENSE - upstream cloud goes down (circuit breaker + local queue)")
    def dead_upstream(_h):              # simulate the in-the-news cloud/CDN outage
        raise ConnectionError("upstream 503 / DNS failure")
    emerg_rec = next(r for r in results if r["threat"] == "CRITICAL_EMERGENCY")
    for i in range(4):
        print(f"  export try {i+1}: {hub.request_external_sync(emerg_rec, upstream=dead_upstream)}")
    print(f"  -> degraded_mode={hub.degraded_mode}, queued={len(hub.export_queue)} "
          f"(life-safety triage kept running the whole time)")
    print("  ... upstream recovers ...")
    time.sleep(3.1)                    # let the breaker cool down to half-open
    hub.flush_export_queue(lambda h: f"synced {h[:12]}")
    print(f"  -> after recovery: degraded_mode={hub.degraded_mode}, queued={len(hub.export_queue)}")

    _banner("3) OUTAGE DEFENSE - a BAD detector update is blocked + auto-rolled-back")
    good = hub.apply_detector_update(DetectorConfig(mad_k=5.5))          # safe tweak -> applied
    bad = hub.apply_detector_update(DetectorConfig(emergency_min_burst=999))  # would miss falls
    print(f"  safe update : applied={good.applied}  confidence={good.confidence:.0%}")
    print(f"  bad  update : applied={bad.applied}  confidence={bad.confidence:.0%}  -> {bad.reason}")
    # prove the node still detects a fall after the rejected update:
    still_ok = hub.detector.analyze_waveform(emergency)["threat"]
    print(f"  node still detects the fall after rollback: {still_ok.name}")

    _banner("4) MESH FAILOVER - a peer goes stale, routing fails over; quorum checked")
    hub.peer_health["mesh_node_B"] = time.time() - 120     # force it stale
    print(f"  healthy peers : {hub.healthy_peers()}")
    print(f"  failover from mesh_node_B -> {hub.failover_route(exclude='mesh_node_B')}")
    print(f"  quorum of 3 peers present? {hub.has_quorum(total_peers=3)}")

    _banner("LEDGER / VAULT")
    print(f"  node revenue   : {hub.billing.node_revenue_sats} sats")
    print(f"  peer balances  : {hub.billing.peer_balances}")
    print(f"  vault records  : {len(hub.local_vault)} (encrypted at {policy.vault_path})")
    hub.shutdown()
    print("=" * 78)


