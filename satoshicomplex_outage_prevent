# --------------------------------------------------------------------------- #
#  Real authenticated encryption (stdlib only): CTR keystream + encrypt-then-MAC
# --------------------------------------------------------------------------- #
class SovereignCipher:
    """
    Authenticated encryption with associated data, standard library only.
    keystream = HMAC-SHA256(enc_key, nonce||counter) in CTR mode; the plaintext
    is XORed with it, then an HMAC-SHA256 tag covers nonce||ciphertext (encrypt-
    then-MAC). This genuinely hides the plaintext - unlike the previous version,
    which stored records in the clear behind a tag.
    """

    def __init__(self, master_key: bytes):
        self.enc_key = hmac.new(master_key, b"satoshi-enc-v1", hashlib.sha256).digest()
        self.mac_key = hmac.new(master_key, b"satoshi-mac-v1", hashlib.sha256).digest()

    def _keystream(self, nonce: bytes, n: int) -> bytes:
        out = bytearray()
        counter = 0
        while len(out) < n:
            out += hmac.new(self.enc_key, nonce + counter.to_bytes(8, "big"),
                            hashlib.sha256).digest()
            counter += 1
        return bytes(out[:n])

    def encrypt(self, plaintext: bytes) -> bytes:
        nonce = secrets.token_bytes(16)
        ks = self._keystream(nonce, len(plaintext))
        ct = bytes(a ^ b for a, b in zip(plaintext, ks))
        tag = hmac.new(self.mac_key, nonce + ct, hashlib.sha256).digest()
        return nonce + tag + ct

    def decrypt(self, blob: bytes) -> Optional[bytes]:
        if len(blob) < 48:
            return None
        nonce, tag, ct = blob[:16], blob[16:48], blob[48:]
        if not hmac.compare_digest(tag, hmac.new(self.mac_key, nonce + ct,
                                                 hashlib.sha256).digest()):
            return None  # tampered or wrong key
        ks = self._keystream(nonce, len(ct))
        return bytes(a ^ b for a, b in zip(ct, ks))


