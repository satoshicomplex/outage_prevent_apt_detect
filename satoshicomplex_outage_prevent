@dataclass
class ConstitutionalPolicy:
    owner_pubkey_hex: str
    local_hold_seconds: int = 86400 * 7
    allow_external_telemetry: bool = False
    emergency_override_enabled: bool = True
    vault_path: Path = Path("sovereign_vault.bin")

    def cipher(self) -> SovereignCipher:
        return SovereignCipher(bytes.fromhex(self.owner_pubkey_hex))

    def verify_export_authorization(self, payload_hash: str,
                                    signature_hex: Optional[str],
                                    threat_level: ThreatLevel) -> bool:
        if threat_level == ThreatLevel.CRITICAL_EMERGENCY and self.emergency_override_enabled:
            log.warning("Emergency override: external export permitted under life-safety exception")
            return True
        if not self.allow_external_telemetry:
            raise ConstitutionalComplianceError(
                "Blocked: external telemetry disabled (Sovereign Residential Privacy Policy)")
        if not signature_hex:
            raise ConstitutionalComplianceError("Blocked: missing owner authorization signature")
        expected = hmac.new(bytes.fromhex(self.owner_pubkey_hex),
                            payload_hash.encode(), hashlib.sha256).hexdigest()
        if not hmac.compare_digest(expected, signature_hex):
            raise ConstitutionalComplianceError("Blocked: invalid owner authorization signature")
        return True


# --------------------------------------------------------------------------- #
#  Billing: prepaid per-peer balance; safety is never gated on payment
# --------------------------------------------------------------------------- #
@dataclass
class CryptoBillingLedger:
    base_query_cost_sats: int = 10
    probe_penalty_multiplier: int = 100
    node_revenue_sats: int = 0
    peer_balances: Dict[str, int] = field(default_factory=dict)
    ledger_log: List[Dict[str, Any]] = field(default_factory=list)

    def topup(self, peer_id: str, sats: int, preimage: Optional[str] = None) -> str:
        """Lightning-style top-up (preimage proves an off-chain payment)."""
        pre = preimage or secrets.token_hex(32)
        payment_hash = hashlib.sha256(pre.encode()).hexdigest()
        self.peer_balances[peer_id] = self.peer_balances.get(peer_id, 0) + sats
        return payment_hash

    def assess_cost(self, threat: ThreatLevel) -> int:
        if threat == ThreatLevel.CRITICAL_EMERGENCY:
            return 0
        cost = self.base_query_cost_sats
        if threat == ThreatLevel.REVERSE_ENGINEERING_PROBE:
            cost *= self.probe_penalty_multiplier   # attackers pay the toll
        return cost

    def charge(self, peer_id: str, threat: ThreatLevel) -> Tuple[bool, int, str]:
        cost = self.assess_cost(threat)
        ts = time.time()
        if cost == 0:
            self.ledger_log.append({"ts": ts, "peer": peer_id, "cost_sats": 0,
                                    "status": "EMERGENCY_FREE_BYPASS"})
            return True, 0, "Emergency life-safety bypass (0 sats)"
        bal = self.peer_balances.get(peer_id, 0)
        if bal >= cost:
            self.peer_balances[peer_id] = bal - cost
            self.node_revenue_sats += cost
            self.ledger_log.append({"ts": ts, "peer": peer_id, "cost_sats": cost,
                                    "status": "SETTLED"})
            return True, cost, f"Settled {cost} sats (balance {self.peer_balances[peer_id]})"
        # Safety-first: we still process, but flag the debt instead of blocking.
        self.ledger_log.append({"ts": ts, "peer": peer_id, "cost_sats": cost,
                                "status": "UNPAID_FLAGGED"})
        return False, cost, f"Unpaid: {cost} sats due (balance {bal}) - processed anyway, flagged"


# --------------------------------------------------------------------------- #
#  DSP anomaly detector  (classification bug fixed via burst analysis)
# --------------------------------------------------------------------------- #
@dataclass
class DetectorConfig:
    sample_rate_hz: int = 250
    mad_k: float = 6.0            # burst threshold = median + mad_k * MAD
    emergency_min_burst: int = 15  # samples of sustained excursion => distress
    probe_max_burst: int = 14      # short sharp burst => fault-injection probe
    probe_min_peak: float = 2.5
    tonal_ratio_probe: float = 0.45  # single-bin spectral dominance => clock injection
    tonal_min_freq_hz: float = 20.0


class DSPAnomalyDetector:
    """Sub-second spectral + burst engine for health sensors and side-channel probes."""

    def __init__(self, config: Optional[DetectorConfig] = None):
        self.cfg = config or DetectorConfig()

    @staticmethod
    def _run_lengths(mask: np.ndarray) -> List[int]:
        lengths, run = [], 0
        for v in mask:
            if v:
                run += 1
            elif run:
                lengths.append(run); run = 0
        if run:
            lengths.append(run)
        return lengths

    def analyze_waveform(self, signal: np.ndarray) -> Dict[str, Any]:
        c = self.cfg
        if signal.size < 8:
            return {"status": "INSUFFICIENT", "threat": ThreatLevel.NOMINAL, "anomaly_score": 0.0}

        window = np.hanning(signal.size)
        centered = (signal - np.mean(signal)) * window

        power = np.abs(np.fft.rfft(centered)) ** 2
        norm_power = power / (float(np.sum(power)) + 1e-12)
        entropy = float(-np.sum(norm_power * np.log2(norm_power + 1e-12)))
        max_entropy = math.log2(len(norm_power)) if len(norm_power) > 1 else 1.0
        norm_entropy = entropy / max_entropy
        geo = float(np.exp(np.mean(np.log(norm_power + 1e-12))))
        flatness = geo / (float(np.mean(norm_power)) + 1e-12)

        rms = float(np.sqrt(np.mean(centered ** 2))) + 1e-12
        peak = float(np.max(np.abs(centered)))
        crest = peak / rms
        freqs = np.fft.rfftfreq(signal.size, 1.0 / c.sample_rate_hz)
        dom_freq = float(freqs[int(np.argmax(power))])
        tonal_ratio = float(np.max(norm_power))            # single-bin dominance

        # --- burst analysis: distinguish a short injection glitch from a fall ---
        absig = np.abs(centered)
        med = float(np.median(absig))
        mad = float(np.median(np.abs(absig - med))) + 1e-9
        thr = med + c.mad_k * mad
        runs = self._run_lengths(absig > thr)
        max_burst = max(runs) if runs else 0
        has_excursion = peak > thr and peak > c.probe_min_peak

        # --- composite anomaly score (for ELEVATED and transparency) ---
        score = 0.0
        if crest > 6.0:
            score += 0.4
        if dom_freq >= c.tonal_min_freq_hz:   # tonality is only suspicious OFF the
            if norm_entropy < 0.40:           # physiological band - a clean breathing /
                score += 0.35                 # pulse tone near 1 Hz is normal, a 60 Hz
            if flatness < 0.15:               # clock line is not
                score += 0.25

        # --- classification ---
        threat = ThreatLevel.NOMINAL
        tonal_injection = tonal_ratio >= c.tonal_ratio_probe and dom_freq >= c.tonal_min_freq_hz
        if has_excursion and max_burst >= c.emergency_min_burst:
            threat = ThreatLevel.CRITICAL_EMERGENCY        # sustained excursion = distress/fall
        elif tonal_injection or (has_excursion and 0 < max_burst <= c.probe_max_burst):
            threat = ThreatLevel.REVERSE_ENGINEERING_PROBE  # clock tone OR short sharp glitch
        elif score >= 0.45:
            threat = ThreatLevel.ELEVATED

        return {"rms": round(rms, 4), "peak": round(peak, 4), "crest_factor": round(crest, 4),
                "normalized_entropy": round(norm_entropy, 4), "spectral_flatness": round(flatness, 4),
                "dominant_freq_hz": round(dom_freq, 2), "tonal_ratio": round(tonal_ratio, 4),
                "max_burst_samples": max_burst, "anomaly_score": round(score, 4), "threat": threat}


# --------------------------------------------------------------------------- #
#  OUTAGE DEFENSE #1 - circuit breaker (stops a cloud outage from cascading)
# --------------------------------------------------------------------------- #
class CircuitBreaker:
    def __init__(self, name: str, fail_max: int = 3, reset_timeout: float = 5.0):
        self.name = name
        self.fail_max = fail_max
        self.reset_timeout = reset_timeout
        self.state = CircuitState.CLOSED
        self.fails = 0
        self.opened_at = 0.0

    def call(self, fn: Callable, *args, **kwargs):
        if self.state == CircuitState.OPEN:
            if time.time() - self.opened_at >= self.reset_timeout:
                self.state = CircuitState.HALF_OPEN
                log.info("[breaker:%s] half-open - probing upstream recovery", self.name)
            else:
                raise CircuitOpenError(f"{self.name} circuit open - serving locally")
        try:
            result = fn(*args, **kwargs)
        except Exception:
            self.fails += 1
            if self.fails >= self.fail_max and self.state != CircuitState.OPEN:
                self.state = CircuitState.OPEN
                self.opened_at = time.time()
                log.warning("[breaker:%s] OPEN after %d failures - shedding upstream load",
                            self.name, self.fails)
            raise
        if self.state in (CircuitState.HALF_OPEN, CircuitState.OPEN):
            log.info("[breaker:%s] upstream recovered - closing", self.name)
        self.state = CircuitState.CLOSED
        self.fails = 0
        return result


# --------------------------------------------------------------------------- #
#  OUTAGE DEFENSE #2 - UpdateGuard (a bad update can never brick the node)
# --------------------------------------------------------------------------- #
@dataclass
class UpdateResult:
    applied: bool
    confidence: float
    reason: str
    rolled_back: bool
    notes: List[str] = field(default_factory=list)


class UpdateGuard:
    """
    Defends against the 'a pushed update takes everything down' outage.
    Any config/model/policy change is validated against golden cases on a shadow
    copy FIRST; it is committed only if confidence >= min_confidence, otherwise
    the previous known-good state is kept (auto-rollback).
    """

    def __init__(self, golden_cases: List[Tuple[np.ndarray, ThreatLevel]],
                 min_confidence: float = 0.9):
        self.golden = golden_cases
        self.min_confidence = min_confidence

    def guarded_apply(self, current: Any, candidate: Any,
                      classify: Callable[[Any, np.ndarray], ThreatLevel]) -> Tuple[Any, UpdateResult]:
        if not self.golden:
            return candidate, UpdateResult(True, 1.0, "no golden cases - applied unchecked", False)
        passed, notes = 0, []
        for i, (wave, expected) in enumerate(self.golden):
            try:
                got = classify(candidate, wave)
                if got == expected:
                    passed += 1
                else:
                    notes.append(f"golden#{i}: got {got.name}, expected {expected.name}")
            except Exception as e:                        # a crash counts as a failure
                notes.append(f"golden#{i}: candidate raised {type(e).__name__}: {e}")
        confidence = passed / len(self.golden)
        if confidence >= self.min_confidence:
            return candidate, UpdateResult(True, confidence,
                                           f"validated {passed}/{len(self.golden)} golden cases",
                                           False, notes)
        return current, UpdateResult(False, confidence,
                                     f"REJECTED + rolled back: only {passed}/{len(self.golden)} "
                                     f"golden cases pass", True, notes)


# --------------------------------------------------------------------------- #
#  The hub
# --------------------------------------------------------------------------- #
class SatoshiComplexHub:
    def __init__(self, policy: ConstitutionalPolicy, max_workers: int = 4):
        self.policy = policy
        self.cipher = policy.cipher()
        self.detector = DSPAnomalyDetector()
        self.billing = CryptoBillingLedger()
        self.executor = ThreadPoolExecutor(max_workers=max_workers)
        self.local_vault: List[Dict[str, Any]] = []
        self.export_queue: List[Dict[str, Any]] = []        # durable buffer during outages
        self.peer_health: Dict[str, float] = {}
        self.sync_breaker = CircuitBreaker("external-sync", fail_max=3, reset_timeout=3.0)
        self.update_guard = UpdateGuard(self._golden_cases())
        self._load_vault()

    # ---- golden cases for UpdateGuard -------------------------------------- #
    @staticmethod
    def _golden_cases() -> List[Tuple[np.ndarray, ThreatLevel]]:
        rng = np.random.default_rng(7)
        t = np.linspace(0, 1.0, 250)
        nominal = 0.5 * np.sin(2 * np.pi * 1.2 * t) + rng.normal(0, 0.12, t.shape)
        emergency = rng.normal(0, 0.35, t.shape); emergency[70:90] += rng.normal(7.5, 1.0, 20)
        return [(nominal, ThreatLevel.NOMINAL), (emergency, ThreatLevel.CRITICAL_EMERGENCY)]

    # ---- encrypted vault --------------------------------------------------- #
    def _load_vault(self) -> None:
        if not self.policy.vault_path.exists():
            return
        data = self.cipher.decrypt(self.policy.vault_path.read_bytes())
        if data is None:
            log.error("Vault failed authentication (tampered or wrong key) - starting fresh")
            return
        for line in data.decode().splitlines():
            if line.strip():
                self.local_vault.append(json.loads(line))
        log.info("Loaded %d encrypted vault records", len(self.local_vault))

    def _persist_vault(self) -> None:
        payload = "\n".join(json.dumps(r) for r in self.local_vault[-2000:]).encode()
        tmp = self.policy.vault_path.with_suffix(".tmp")
        tmp.write_bytes(self.cipher.encrypt(payload))
        tmp.replace(self.policy.vault_path)                 # atomic swap

    # ---- update safety ----------------------------------------------------- #
    def apply_detector_update(self, candidate_cfg: DetectorConfig) -> UpdateResult:
        """Route every detector-config change through the UpdateGuard."""
        def classify(cfg: DetectorConfig, wave: np.ndarray) -> ThreatLevel:
            return DSPAnomalyDetector(cfg).analyze_waveform(wave)["threat"]
        new_cfg, result = self.update_guard.guarded_apply(self.detector.cfg, candidate_cfg, classify)
        self.detector = DSPAnomalyDetector(new_cfg)
        if result.applied:
            log.info("Detector update applied (confidence %.0f%%)", result.confidence * 100)
        else:
            log.warning("Detector update %s", result.reason)
            for n in result.notes:
                log.warning("   - %s", n)
        return result

    # ---- triage ------------------------------------------------------------ #
    def _process_single_sensor(self, sensor_id: str, samples: np.ndarray,
                               peer_id: str) -> Dict[str, Any]:
        t0 = time.perf_counter()
        self.peer_health[peer_id] = time.time()
        try:
            analysis = self.detector.analyze_waveform(samples)
        except Exception as e:                              # a sensor must never crash the hub
            analysis = {"threat": ThreatLevel.ELEVATED, "error": str(e)}
        threat: ThreatLevel = analysis.get("threat", ThreatLevel.ELEVATED)
        paid, cost, billing_msg = self.billing.charge(peer_id, threat)
        record = {"sensor_id": sensor_id, "peer_id": peer_id, "timestamp": time.time(),
                  "metrics": {k: v for k, v in analysis.items() if k != "threat"},
                  "threat": threat.name,
                  "billing": {"authorized": paid, "cost_sats": cost, "detail": billing_msg},
                  "latency_ms": round((time.perf_counter() - t0) * 1000, 3)}
        self.local_vault.append(record)
        return record

    def triage_batch(self, batch: List[Tuple[str, np.ndarray, str]],
                     timeout_sec: float = 0.8) -> List[Dict[str, Any]]:
        futures = {self.executor.submit(self._process_single_sensor, *item): item for item in batch}
        results = []
        for f, item in futures.items():
            try:
                results.append(f.result(timeout=timeout_sec))
            except FuturesTimeoutError:                     # degraded, but never a silent drop
                rec = {"sensor_id": item[0], "peer_id": item[2], "threat": "ELEVATED",
                       "error": "triage_timeout", "degraded": True, "timestamp": time.time()}
                self.local_vault.append(rec); results.append(rec)
            except Exception as e:
                results.append({"sensor_id": item[0], "error": str(e), "threat": "ELEVATED"})
        self._persist_vault()
        return results

    # ---- outage-resilient export ------------------------------------------ #
    @property
    def degraded_mode(self) -> bool:
        return self.sync_breaker.state != CircuitState.CLOSED

    def request_external_sync(self, record: Dict[str, Any],
                              owner_sig: Optional[str] = None,
                              upstream: Optional[Callable[[str], str]] = None) -> str:
        """
        Export a record upstream. Sovereignty is enforced first; then the actual
        network call goes through the circuit breaker. If upstream is down we do
        NOT hang or fail the node - we queue locally and keep serving.
        """
        payload = json.dumps(record, sort_keys=True).encode()
        phash = hashlib.sha256(payload).hexdigest()
        threat = ThreatLevel[record["threat"]]
        self.policy.verify_export_authorization(phash, owner_sig, threat)  # may raise (by design)

        def do_upstream() -> str:
            return (upstream or (lambda h: f"synced {h[:12]}"))(phash)

        try:
            res = self.sync_breaker.call(do_upstream)
            return f"Export delivered for {record['sensor_id']}: {res}"
        except (CircuitOpenError, Exception) as e:
            self.export_queue.append({"record": record, "hash": phash, "queued_at": time.time()})
            return (f"Upstream unavailable ({type(e).__name__}); QUEUED locally for "
                    f"{record['sensor_id']} (queue depth {len(self.export_queue)}) - node stays up")

    def flush_export_queue(self, upstream: Callable[[str], str]) -> int:
        """On recovery, drain the queue (jittered to avoid a thundering herd)."""
        sent, still = 0, []
        for item in self.export_queue:
            try:
                self.sync_breaker.call(upstream, item["hash"])
                sent += 1
                time.sleep(0.001 + secrets.randbelow(3) / 1000.0)  # jitter
            except Exception:
                still.append(item)
        self.export_queue = still
        if sent:
            log.info("Flushed %d queued export(s) after recovery; %d still pending", sent, len(still))
        return sent

    # ---- mesh health / failover ------------------------------------------- #
    def healthy_peers(self, max_age_sec: float = 30.0) -> List[str]:
        now = time.time()
        return [p for p, ts in self.peer_health.items() if now - ts < max_age_sec]

    def failover_route(self, exclude: Optional[str] = None,
                       max_age_sec: float = 30.0) -> Optional[str]:
        healthy = [p for p in self.healthy_peers(max_age_sec) if p != exclude]
        return healthy[0] if healthy else None             # None => isolated, go local-only

    def has_quorum(self, total_peers: int, max_age_sec: float = 30.0) -> bool:
        return len(self.healthy_peers(max_age_sec)) >= (total_peers // 2 + 1)

    def shutdown(self) -> None:
        self._persist_vault()
        self.executor.shutdown(wait=True)


